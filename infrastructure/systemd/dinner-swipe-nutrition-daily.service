[Unit]
Description=Dinner Swipe usage-driven nutrition refresh (bounded FatSecret budget)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=codexvps
Group=codexvps
WorkingDirectory=/home/codexvps/Desktop/projects/dinner-swipe
ExecStart=/usr/bin/bash infrastructure/scripts/run-nutrition-job.sh
TimeoutStartSec=12min
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
