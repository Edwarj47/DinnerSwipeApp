# Private template only. Do not point this stack at production or copy live data.
# Keep APP_ENV=production for production-strength secrets/cookie security.
APP_ENV=production
DEPLOYMENT_TIER=staging
APP_PUBLIC_URL=https://replace-with-approved-staging-origin.invalid
PUBLIC_API_URL=https://replace-with-approved-staging-origin.invalid
ALLOWED_ORIGINS=https://replace-with-approved-staging-origin.invalid
JWT_SECRET=replace-with-a-new-random-staging-secret
DINNER_STAGING_PORT=19341
DINNER_STAGING_POSTGRES_PASSWORD=replace-with-a-new-random-owner-password
DINNER_STAGING_RUNTIME_PASSWORD=replace-with-a-distinct-random-runtime-password
DINNER_STAGING_MIGRATION_URL=postgresql+psycopg://dinner_swipe_staging_owner:REPLACE@postgres:5432/dinner_swipe_staging
DINNER_STAGING_RUNTIME_URL=postgresql+psycopg://dinner_swipe_staging_runtime:REPLACE@postgres:5432/dinner_swipe_staging
COMPLIMENTARY_PREMIUM_ENABLED=true
STRIPE_ENABLED=false
FATSECRET_ENABLED=false
FATSECRET_REFRESH_ENABLED=false
AI_INGESTION_ENABLED=false
AI_RECIPE_ENABLED=false
NUTRITION_AI_ENABLED=false
NUTRITION_VOICE_ENABLED=false
WORKOUTS_ENABLED=true
MEDIA_CLEANUP_ENABLED=false
