{
  "expo": {
    "name": "Dinner Swipe",
    "owner": "data-centric-software-solutions",
    "slug": "dinner-swipe",
    "scheme": "dinnerswipe",
    "version": "0.2.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbe8bf7c-1e7e-4ace-9cd8-68f231173d90",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/appearance/black.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "dev.dcss.dinnerswipe",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dinner Swipe lets you choose recipe photos from your library."
      }
    },
    "android": {
      "package": "dev.dcss.dinnerswipe",
      "adaptiveIcon": {
        "foregroundImage": "./assets/appearance/black.png",
        "backgroundColor": "#111111"
      },
      "versionCode": 29
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/appearance/black.png",
      "name": "Dinner Swipe",
      "shortName": "DinnerSwipe",
      "themeColor": "#111111",
      "backgroundColor": "#fff6f3"
    },
    "plugins": [
      "expo-router",
      ["expo-splash-screen", { "image": "./assets/appearance/black.png", "resizeMode": "contain", "backgroundColor": "#111111", "imageWidth": 200 }],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a recipe photo from your library.",
          "cameraPermission": "Take a photo for a recipe.",
          "microphonePermission": "Allow Dinner Swipe to record a meal description."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Dinner Swipe to use Face ID to unlock your saved session."
        }
      ],
      "./plugins/withAndroidMonorepoGradlePaths",
      "./plugins/withAppIcons",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Dinner Swipe to record a meal description.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": false,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fbe8bf7c-1e7e-4ace-9cd8-68f231173d90"
      }
    }
  }
}
