{
  "cli": {
    "version": ">= 12.5.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Dinner Swipe",
        "EXPO_PUBLIC_API_URL": "https://dinner.dcss.dev",
        "EXPO_PUBLIC_FEATURE_AI_INGESTION": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Dinner Swipe",
        "EXPO_PUBLIC_API_URL": "https://dinner.dcss.dev",
        "EXPO_PUBLIC_FEATURE_AI_INGESTION": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_NAME": "Dinner Swipe",
        "EXPO_PUBLIC_API_URL": "https://dinner.dcss.dev",
        "EXPO_PUBLIC_FEATURE_AI_INGESTION": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
