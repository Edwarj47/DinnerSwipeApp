APP_ENV=development
APP_PUBLIC_URL=http://127.0.0.1:8109
PUBLIC_API_URL=http://127.0.0.1:8108
DATABASE_URL=postgresql+psycopg://dinner_swipe_app:change-me@dinner-swipe-postgres:5432/dinner_swipe
JWT_SECRET=replace-with-32-byte-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_INGESTION_ENABLED=false
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_IMPORT_ROWS=2000
MAX_CELL_LENGTH=10000
MAX_URL_RESPONSE_SIZE_BYTES=2097152
MAX_IMAGE_UPLOAD_SIZE_BYTES=5242880
IMAGE_STORAGE_PATH=/app/media
ALLOWED_ORIGINS=http://127.0.0.1:8109,http://127.0.0.1:19006,http://localhost:19006
EXPO_PUBLIC_API_URL=http://127.0.0.1:8108
EXPO_PUBLIC_APP_NAME=Dinner Swipe
EXPO_PUBLIC_FEATURE_AI_INGESTION=false
